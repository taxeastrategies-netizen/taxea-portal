{
  "name": "DailyDocumentBackupToDrive",
  "description": "Copia de seguridad autom\u00e1tica diaria de toda la documentaci\u00f3n a Google Drive (taxeastrategies@gmail.com)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "Atlantic/Canary",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "dailydocumentbackuptodrive",
      "version": "2.0",
      "namespace": "base44"
    },
    "do": [
      {
        "probe_call": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "taxModelOperations",
            "args": {
              "action": "self_test"
            }
          },
          "then": "inspect_shape"
        }
      },
      {
        "inspect_shape": {
          "switch": [
            {
              "when": "${ .probe_call | has(\"ok\") }",
              "then": "probe_direct_ok"
            },
            {
              "when": "${ .probe_call | has(\"data\") }",
              "then": "probe_direct_data"
            },
            {
              "when": "${ .probe_call | has(\"result\") }",
              "then": "probe_direct_result"
            },
            {
              "when": "${ .probe_call | has(\"response\") }",
              "then": "probe_direct_response"
            },
            {
              "when": "${ .probe_call | has(\"output\") }",
              "then": "probe_direct_output"
            },
            {
              "when": "${ true }",
              "then": "unknown"
            }
          ]
        }
      },
      {
        "probe_direct_ok": {
          "wait": {
            "seconds": 1
          },
          "then": "end"
        }
      },
      {
        "probe_direct_data": {
          "wait": {
            "seconds": 1
          },
          "then": "end"
        }
      },
      {
        "probe_direct_result": {
          "wait": {
            "seconds": 1
          },
          "then": "end"
        }
      },
      {
        "probe_direct_response": {
          "wait": {
            "seconds": 1
          },
          "then": "end"
        }
      },
      {
        "probe_direct_output": {
          "wait": {
            "seconds": 1
          },
          "then": "end"
        }
      },
      {
        "unknown": {
          "wait": {
            "seconds": 1
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "documentBackupToDrive"
  }
}