{
  "name": "DailyDocumentBackupToDrive",
  "description": "Copia de seguridad autom\u00e1tica diaria de toda la documentaci\u00f3n a Google Drive (taxeastrategies@gmail.com)",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "Atlantic/Canary",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "dailydocumentbackuptodrive",
      "version": "2.0",
      "namespace": "base44"
    },
    "do": [
      {
        "probe_call": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "taxModelOperations",
            "args": {
              "action": "self_test"
            }
          },
          "then": "inspect_shape"
        }
      },
      {
        "inspect_shape": {
          "switch": [
            {
              "when": "${ has(\"ok\") }",
              "then": "root_ok"
            },
            {
              "when": "${ has(\"result\") }",
              "then": "root_result"
            },
            {
              "when": "${ has(\"data\") }",
              "then": "root_data"
            },
            {
              "when": "${ has(\"steps\") }",
              "then": "root_steps"
            },
            {
              "when": "${ has(\"output\") }",
              "then": "root_output"
            },
            {
              "when": "${ has(\"input\") }",
              "then": "root_input"
            },
            {
              "when": "${ has(\"probe_call\") }",
              "then": "root_probe_call"
            },
            {
              "when": "${ has(\"tasks\") }",
              "then": "root_tasks"
            },
            {
              "when": "${ has(\"results\") }",
              "then": "root_results"
            },
            {
              "when": "${ true }",
              "then": "unknown"
            }
          ]
        }
      },
      {
        "root_ok": {
          "wait": {
            "seconds": 1
          },
          "then": "end"
        }
      },
      {
        "root_result": {
          "wait": {
            "seconds": 1
          },
          "then": "end"
        }
      },
      {
        "root_data": {
          "wait": {
            "seconds": 1
          },
          "then": "end"
        }
      },
      {
        "root_steps": {
          "wait": {
            "seconds": 1
          },
          "then": "end"
        }
      },
      {
        "root_output": {
          "wait": {
            "seconds": 1
          },
          "then": "end"
        }
      },
      {
        "root_input": {
          "wait": {
            "seconds": 1
          },
          "then": "end"
        }
      },
      {
        "root_probe_call": {
          "wait": {
            "seconds": 1
          },
          "then": "end"
        }
      },
      {
        "root_tasks": {
          "wait": {
            "seconds": 1
          },
          "then": "end"
        }
      },
      {
        "root_results": {
          "wait": {
            "seconds": 1
          },
          "then": "end"
        }
      },
      {
        "unknown": {
          "wait": {
            "seconds": 1
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "documentBackupToDrive"
  }
}