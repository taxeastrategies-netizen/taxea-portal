{
  "name": "Renovar licitaciones hosted",
  "description": "Renueva cada 30 minutos la copia temporal de la primera p\u00e1gina oficial: Licitaciones PLACSP alojadas. Si falla, conserva la \u00faltima copia correcta.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "2,32 * * * *",
      "one_time_date": null,
      "timezone": "Europe/Madrid",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "refresh_tenders_hosted",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "searchTenders",
            "args": {
              "action": "refresh_source",
              "source": "hosted"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}