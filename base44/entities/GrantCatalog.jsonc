{
  "name": "GrantCatalog",
  "type": "object",
  "properties": {
    "bdnsId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "upcoming",
        "closed"
      ]
    },
    "publishedAt": {
      "type": "string"
    },
    "opensAt": {
      "type": "string"
    },
    "closesAt": {
      "type": "string"
    },
    "regionCodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "beneficiaryTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "finality": {
      "type": "string"
    },
    "administration": {
      "type": "string"
    },
    "searchText": {
      "type": "string"
    },
    "payload": {
      "type": "string"
    },
    "checkedAt": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    }
  },
  "required": [
    "bdnsId",
    "title",
    "status",
    "checkedAt",
    "sourceUrl"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}