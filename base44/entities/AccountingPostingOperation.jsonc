{
  "name": "AccountingPostingOperation",
  "type": "object",
  "properties": {
    "companyId": { "type": "string" },
    "operationKey": { "type": "string" },
    "operationType": { "type": "string" },
    "payloadHash": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["preparing", "committed", "recovery_required", "failed", "superseded"],
      "default": "preparing"
    },
    "stage": { "type": "string" },
    "journalEntryId": { "type": "string" },
    "documentId": { "type": "string" },
    "bankTransactionId": { "type": "string" },
    "paymentId": { "type": "string" },
    "attempts": { "type": "integer", "default": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "heartbeatAt": { "type": "string", "format": "date-time" },
    "committedAt": { "type": "string", "format": "date-time" },
    "lastError": { "type": "string" },
    "actor": { "type": "string" },
    "schemaVersion": { "type": "string" }
  },
  "required": ["companyId", "operationKey", "operationType", "payloadHash", "status"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.companyId": "{{user.data.company_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
