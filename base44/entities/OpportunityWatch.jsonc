{
  "name": "OpportunityWatch",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "grant",
        "tender"
      ]
    },
    "title": {
      "type": "string"
    },
    "criteria": {
      "type": "object"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "seen_signatures": {
      "type": "object",
      "description": "Identificadores y fechas oficiales vistos en la \u00faltima revisi\u00f3n de esta b\u00fasqueda."
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "last_attempt_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_alert_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    },
    "last_examined_count": {
      "type": "number"
    },
    "last_coverage_limited": {
      "type": "boolean"
    },
    "unread_count": {
      "type": "number",
      "default": 0
    },
    "unread_items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "company_id",
    "kind",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.company_id": "{{user.data.company_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.company_id": "{{user.data.company_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.company_id": "{{user.data.company_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}