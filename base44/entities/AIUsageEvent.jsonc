{
  "name": "AIUsageEvent",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "userEmail": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "minuteKey": {
      "type": "string"
    },
    "dayKey": {
      "type": "string"
    },
    "monthKey": {
      "type": "string"
    },
    "requestId": {
      "type": "string"
    },
    "operation": {
      "type": "string",
      "enum": [
        "llm",
        "fiscal_assistant"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "reserved",
        "success",
        "error",
        "blocked"
      ],
      "default": "reserved"
    },
    "model": {
      "type": "string"
    },
    "promptChars": {
      "type": "number",
      "default": 0
    },
    "estimatedInputTokens": {
      "type": "number",
      "default": 0
    },
    "estimatedOutputTokens": {
      "type": "number",
      "default": 0
    },
    "internetContext": {
      "type": "boolean",
      "default": false
    },
    "fileCount": {
      "type": "number",
      "default": 0
    },
    "errorCode": {
      "type": "string"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "userId",
    "minuteKey",
    "dayKey",
    "monthKey",
    "requestId",
    "operation"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}