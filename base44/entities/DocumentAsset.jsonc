{
  "name": "DocumentAsset",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "object_name": {
      "type": "string"
    },
    "generation": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    },
    "size": {
      "type": "integer"
    },
    "mime_type": {
      "type": "string"
    },
    "original_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "deleted"
      ]
    },
    "uploaded_by": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "storage_provider": {
      "type": "string",
      "enum": [
        "gcs"
      ]
    },
    "deleted_at": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "object_name",
    "generation",
    "sha256",
    "size",
    "mime_type",
    "original_name",
    "status",
    "storage_provider"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}