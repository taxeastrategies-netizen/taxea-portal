{
  "name": "Company",
  "type": "object",
  "properties": {
    "ocr_approval_lock_token": {
      "type": "string",
      "rls": {
        "read": false,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "ocr_approval_lock_started_at": {
      "type": "string",
      "rls": {
        "read": false,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "nombre_comercial": {
      "type": "string"
    },
    "razon_social": {
      "type": "string"
    },
    "nif_cif": {
      "type": "string"
    },
    "direccion_fiscal": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "telefono": {
      "type": "string"
    },
    "regimen_fiscal": {
      "type": "string",
      "enum": [
        "autonomo",
        "profesional",
        "empresario_individual",
        "sociedad_limitada",
        "sociedad_anonima",
        "comunidad_bienes",
        "asociacion",
        "otro"
      ]
    },
    "tipo_impuesto": {
      "type": "string",
      "enum": [
        "iva",
        "igic",
        "exento",
        "mixto"
      ]
    },
    "actividad": {
      "type": "string"
    },
    "epigrafe_iae": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "datos_bancarios": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "usuarios_autorizados": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "activa": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "razon_social",
    "nif_cif"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "data.usuarios_autorizados": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "data.usuarios_autorizados": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}