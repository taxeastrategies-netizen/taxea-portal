{
  "name": "CoreIntegrationUsage",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "companyId": {
      "type": "string"
    },
    "dayKey": {
      "type": "string"
    },
    "minuteKey": {
      "type": "string"
    },
    "operation": {
      "type": "string",
      "enum": [
        "extract",
        "reminder",
        "tax_notice"
      ]
    },
    "targetId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "reserved",
        "success",
        "error"
      ],
      "default": "reserved"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "userId",
    "companyId",
    "dayKey",
    "minuteKey",
    "operation",
    "targetId"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}