{
  "name": "TaxOfficialFile",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string"
    },
    "modeloCodigo": {
      "type": "string"
    },
    "ejercicio": {
      "type": "number"
    },
    "periodo": {
      "type": "string"
    },
    "administracion": {
      "type": "string",
      "enum": [
        "AEAT",
        "ATC",
        "Otro"
      ],
      "default": "AEAT"
    },
    "nombreFichero": {
      "type": "string"
    },
    "extension": {
      "type": "string"
    },
    "formato": {
      "type": "string"
    },
    "versionDiseno": {
      "type": "string"
    },
    "fileUrl": {
      "type": "string"
    },
    "contentBase64": {
      "type": "string",
      "description": "Contenido exacto e inmutable generado por Taxea, codificado en Base64 para permitir su re-descarga verificable."
    },
    "contentEncoding": {
      "type": "string",
      "enum": [
        "base64"
      ],
      "default": "base64"
    },
    "contentSize": {
      "type": "integer"
    },
    "immutable": {
      "type": "boolean",
      "default": true
    },
    "sourceHash": {
      "type": "string"
    },
    "snapshotHash": {
      "type": "string"
    },
    "hash": {
      "type": "string"
    },
    "generadoPor": {
      "type": "string"
    },
    "fechaGeneracion": {
      "type": "string",
      "format": "date-time"
    },
    "estado": {
      "type": "string",
      "enum": [
        "borrador",
        "generado",
        "descargado",
        "validado_internamente",
        "rechazado_validacion",
        "subido_sede",
        "presentado"
      ],
      "default": "generado"
    },
    "errores": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avisos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "taxDraftId": {
      "type": "string"
    },
    "resumenLegible": {
      "type": "string"
    }
  },
  "required": [
    "companyId",
    "modeloCodigo",
    "ejercicio",
    "periodo"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.companyId": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}