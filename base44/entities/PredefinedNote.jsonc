{
  "name": "PredefinedNote",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string"
    },
    "texto": {
      "type": "string"
    },
    "categoria": {
      "type": "string"
    },
    "impuesto_relacionado": {
      "type": "string"
    },
    "activa": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "titulo",
    "texto"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "advisor"
          }
        },
        {
          "user_condition": {
            "role": "asesor"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}