{
  "name": "Document",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "nombre": {
      "type": "string"
    },
    "carpeta": {
      "type": "string"
    },
    "archivo_url": {
      "type": "string"
    },
    "tipo_archivo": {
      "type": "string"
    },
    "anio": {
      "type": "number"
    },
    "trimestre": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "en_revision",
        "revisado",
        "aprobado",
        "rechazado"
      ],
      "default": "pendiente"
    },
    "etiquetas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comentarios": {
      "type": "string"
    },
    "subido_por": {
      "type": "string"
    },
    "fiscal_model_code": {
      "type": "string"
    },
    "fiscal_period": {
      "type": "string"
    },
    "fiscal_year": {
      "type": "number"
    },
    "fiscal_document_kind": {
      "type": "string",
      "enum": [
        "borrador_modelo",
        "modelo_presentado",
        "justificante_presentacion",
        "carta_pago",
        "notificacion",
        "requerimiento",
        "respuesta_requerimiento",
        "otro"
      ]
    },
    "administracion": {
      "type": "string",
      "enum": [
        "AEAT",
        "ATC",
        "Otro"
      ]
    },
    "tax_obligation_id": {
      "type": "string"
    },
    "tax_filing_id": {
      "type": "string"
    },
    "fiscal_link_status": {
      "type": "string",
      "enum": [
        "sin_clasificar",
        "detectado",
        "vinculado",
        "requiere_revision"
      ],
      "default": "sin_clasificar"
    },
    "fiscal_linked_at": {
      "type": "string",
      "format": "date-time"
    },
    "fiscal_linked_by": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "nombre",
    "archivo_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "advisor"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "advisor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "advisor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "advisor"
          }
        }
      ]
    }
  }
}