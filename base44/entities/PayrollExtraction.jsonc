{
  "name": "PayrollExtraction",
  "type": "object",
  "properties": {
    "labor_ocr_document_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_tax_id": {
      "type": "string"
    },
    "social_security_number": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "company_tax_id": {
      "type": "string"
    },
    "contribution_account_code": {
      "type": "string"
    },
    "professional_group": {
      "type": "string"
    },
    "period_label": {
      "type": "string"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha efectiva de abono de la n\u00f3mina. Determina el per\u00edodo del modelo 111; si falta, el motor usa el per\u00edodo de n\u00f3mina como aproximaci\u00f3n y lo advierte."
    },
    "worked_days": {
      "type": "number"
    },
    "gross_salary": {
      "type": "number"
    },
    "total_accruals": {
      "type": "number"
    },
    "total_deductions": {
      "type": "number"
    },
    "net_pay": {
      "type": "number"
    },
    "irpf_rate": {
      "type": "number"
    },
    "irpf_amount": {
      "type": "number"
    },
    "employee_ss_amount": {
      "type": "number"
    },
    "employer_ss_amount": {
      "type": "number"
    },
    "contribution_base_common": {
      "type": "number"
    },
    "contribution_base_professional": {
      "type": "number"
    },
    "devengos": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "deducciones": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "validation_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence_global": {
      "type": "number",
      "default": 0
    },
    "corrected_by_user": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "labor_ocr_document_id",
    "company_id"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "read": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "update": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "delete": {
      "data.company_id": "{{user.data.company_id}}"
    }
  }
}