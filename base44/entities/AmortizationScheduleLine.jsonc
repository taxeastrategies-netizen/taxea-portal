{
  "name": "AmortizationScheduleLine",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string"
    },
    "assetId": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "postingDate": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number"
    },
    "accumulatedAmount": {
      "type": "number"
    },
    "netBookValue": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "posted"
      ],
      "default": "pending"
    },
    "journalEntryId": {
      "type": "string"
    },
    "postingKey": {
      "type": "string"
    },
    "accountingSchemaVersion": {
      "type": "string"
    }
  },
  "required": [
    "companyId",
    "assetId",
    "period",
    "postingDate",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.companyId": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}