{
  "name": "TaxObligation",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "modelo": {
      "type": "string",
      "enum": [
        "modelo_036",
        "modelo_037",
        "modelo_111",
        "modelo_115",
        "modelo_123",
        "modelo_130",
        "modelo_131",
        "modelo_180",
        "modelo_190",
        "modelo_193",
        "modelo_200",
        "modelo_202",
        "modelo_210",
        "modelo_216",
        "modelo_296",
        "modelo_303",
        "modelo_309",
        "modelo_322",
        "modelo_347",
        "modelo_349",
        "modelo_353",
        "modelo_368",
        "modelo_369",
        "modelo_390",
        "modelo_400_igic",
        "modelo_412_igic",
        "modelo_414_igic",
        "modelo_415_igic",
        "modelo_416_igic",
        "modelo_417_igic",
        "modelo_418_igic",
        "modelo_419_igic",
        "modelo_420_igic",
        "modelo_421_igic",
        "modelo_422_igic",
        "modelo_424_igic",
        "modelo_425_igic",
        "renta",
        "cuentas_anuales",
        "libros_contables",
        "otra"
      ]
    },
    "modelo_codigo": {
      "type": "string"
    },
    "administracion": {
      "type": "string",
      "enum": [
        "AEAT",
        "ATC",
        "Otro"
      ]
    },
    "periodo": {
      "type": "string"
    },
    "anio": {
      "type": "number"
    },
    "trimestre": {
      "type": "string"
    },
    "fecha_inicio_presentacion": {
      "type": "string",
      "format": "date"
    },
    "fecha_limite": {
      "type": "string",
      "format": "date"
    },
    "fecha_limite_domiciliacion": {
      "type": "string",
      "format": "date"
    },
    "fecha_limite_presentacion": {
      "type": "string",
      "format": "date"
    },
    "fecha_limite_interna": {
      "type": "string",
      "format": "date"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente_documentacion",
        "en_preparacion",
        "calculado",
        "borrador",
        "pendiente_revision",
        "revisado",
        "listo_presentar",
        "presentado",
        "domiciliado",
        "pagado",
        "finalizado",
        "rechazado",
        "con_requerimiento",
        "no_aplica"
      ],
      "default": "pendiente_documentacion"
    },
    "resultado": {
      "type": "string",
      "enum": [
        "a_pagar",
        "a_ingresar",
        "a_devolver",
        "a_compensar",
        "cero",
        "informativo",
        "pendiente"
      ],
      "default": "pendiente"
    },
    "importe": {
      "type": "number"
    },
    "justificante_url": {
      "type": "string"
    },
    "comentarios_asesor": {
      "type": "string"
    },
    "calendar_key": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "perfil_fiscal",
        "asesor",
        "documento_fiscal",
        "importacion",
        "legacy"
      ]
    },
    "calendar_rule_version": {
      "type": "string"
    },
    "calendar_confidence": {
      "type": "string",
      "enum": [
        "oficial_verificado",
        "provisional",
        "criterio_asesor"
      ]
    },
    "deadline_status": {
      "type": "string",
      "enum": [
        "verificado",
        "provisional",
        "revisar"
      ]
    },
    "tax_model_id": {
      "type": "string"
    },
    "tax_period_id": {
      "type": "string"
    },
    "tax_filing_id": {
      "type": "string"
    },
    "document_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_synced_by": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "modelo",
    "periodo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "advisor"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "advisor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "advisor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "advisor"
          }
        }
      ]
    }
  }
}