{
  "name": "InvoicePayment",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "method": {
      "type": "string",
      "enum": [
        "transferencia",
        "tarjeta",
        "efectivo",
        "domiciliacion",
        "otro"
      ],
      "default": "transferencia"
    },
    "reference": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "enum": [
        "manual",
        "bank_reconciliation"
      ],
      "default": "manual"
    },
    "bank_transaction_id": {
      "type": "string"
    },
    "journal_entry_id": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "invoice_id",
    "amount",
    "payment_date",
    "origin"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "read": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "update": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "delete": {
      "data.company_id": "{{user.data.company_id}}"
    }
  }
}