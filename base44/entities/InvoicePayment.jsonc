{
  "name": "InvoicePayment",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "method": {
      "type": "string",
      "enum": [
        "transferencia",
        "tarjeta",
        "efectivo",
        "domiciliacion",
        "otro"
      ],
      "default": "transferencia"
    },
    "reference": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "enum": [
        "manual",
        "bank_reconciliation"
      ],
      "default": "manual"
    },
    "bank_transaction_id": {
      "type": "string"
    },
    "journal_entry_id": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    },
    "accounting_operation_id": {
      "type": "string"
    },
    "operation_status": {
      "type": "string",
      "enum": [
        "preparing",
        "committed",
        "recovery_required"
      ],
      "default": "committed"
    },
    "exchange_rate": {
      "type": "number",
      "description": "EUR por unidad de divisa del cobro/pago; fijado al reservar la unidad."
    },
    "amount_eur": {
      "type": "number"
    },
    "carrying_amount_eur": {
      "type": "number"
    },
    "tax_exchange_rate": {
      "type": "number"
    },
    "tax_exchange_rate_source": {
      "type": "string"
    },
    "fx_before_paid": {
      "type": "number"
    },
    "fx_plan": {
      "type": "string",
      "description": "Plan de conversión generado exclusivamente en servidor y congelado para reintentos."
    }
  },
  "required": [
    "company_id",
    "invoice_id",
    "amount",
    "payment_date",
    "origin"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
