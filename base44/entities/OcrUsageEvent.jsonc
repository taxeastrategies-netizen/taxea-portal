{
  "name": "OcrUsageEvent",
  "type": "object",
  "properties": {
    "billingAccountId": {
      "type": "string"
    },
    "quotaPeriodId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "documentId": {
      "type": "string"
    },
    "documentType": {
      "type": "string",
      "enum": [
        "sales_invoice",
        "expense_invoice"
      ]
    },
    "sourceModule": {
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "credits": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "released"
      ],
      "default": "pending"
    },
    "isReprocess": {
      "type": "boolean",
      "default": false
    },
    "relatedPreviousEventId": {
      "type": "string"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "billingAccountId",
    "quotaPeriodId",
    "idempotencyKey"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.billingAccountId": "{{user.data.company_id}}"
        },
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.billingAccountId": "{{user.data.company_id}}"
        },
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.billingAccountId": "{{user.data.company_id}}"
        },
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}