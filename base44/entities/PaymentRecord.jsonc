{
  "name": "PaymentRecord",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "subscriptionId": {
      "type": "string"
    },
    "clientAccountId": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "enum": [
        "stripe",
        "manual"
      ],
      "default": "stripe"
    },
    "stripeInvoiceId": {
      "type": "string"
    },
    "stripePaymentIntentId": {
      "type": "string"
    },
    "stripeChargeId": {
      "type": "string"
    },
    "stripeBalanceTransactionId": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "feeAmount": {
      "type": "number",
      "default": 0
    },
    "netAmount": {
      "type": "number",
      "default": 0
    },
    "refundAmount": {
      "type": "number",
      "default": 0
    },
    "disputeAmount": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "paid",
        "failed",
        "refunded",
        "disputed"
      ],
      "default": "pending"
    },
    "paymentType": {
      "type": "string",
      "enum": [
        "first_payment",
        "renewal",
        "manual_exception"
      ],
      "default": "first_payment"
    },
    "paymentMethod": {
      "type": "string"
    },
    "manualReference": {
      "type": "string"
    },
    "manualEvidenceUrl": {
      "type": "string"
    },
    "createdByAdmin": {
      "type": "string"
    },
    "periodStart": {
      "type": "string",
      "format": "date-time"
    },
    "periodEnd": {
      "type": "string",
      "format": "date-time"
    },
    "paidAt": {
      "type": "string",
      "format": "date-time"
    },
    "failureCode": {
      "type": "string"
    },
    "failureMessageSafe": {
      "type": "string"
    }
  },
  "required": [
    "userId"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}