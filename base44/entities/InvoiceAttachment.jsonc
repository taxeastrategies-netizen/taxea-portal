{
  "name": "InvoiceAttachment",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time"
    },
    "uploaded_by": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "invoice_id",
    "file_uri",
    "filename",
    "uploaded_at"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "read": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "update": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "delete": {
      "data.company_id": "{{user.data.company_id}}"
    }
  }
}