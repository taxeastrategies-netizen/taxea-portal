{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "numero_factura": {
      "type": "string"
    },
    "fecha_emision": {
      "type": "string",
      "format": "date"
    },
    "fecha_vencimiento": {
      "type": "string",
      "format": "date"
    },
    "fecha_operacion": {
      "type": "string",
      "format": "date"
    },
    "cliente_nombre": {
      "type": "string"
    },
    "cliente_nif": {
      "type": "string"
    },
    "cliente_email": {
      "type": "string"
    },
    "cliente_telefono": {
      "type": "string"
    },
    "cliente_direccion": {
      "type": "string"
    },
    "cliente_codigo_postal": {
      "type": "string"
    },
    "cliente_ciudad": {
      "type": "string"
    },
    "cliente_provincia": {
      "type": "string"
    },
    "cliente_pais": {
      "type": "string"
    },
    "proveedor_nombre": {
      "type": "string"
    },
    "proveedor_nif": {
      "type": "string"
    },
    "proveedor_email": {
      "type": "string"
    },
    "proveedor_telefono": {
      "type": "string"
    },
    "proveedor_direccion": {
      "type": "string"
    },
    "proveedor_codigo_postal": {
      "type": "string"
    },
    "proveedor_ciudad": {
      "type": "string"
    },
    "proveedor_provincia": {
      "type": "string"
    },
    "proveedor_pais": {
      "type": "string"
    },
    "concepto": {
      "type": "string"
    },
    "categoria_gasto": {
      "type": "string",
      "enum": [
        "ventas_servicios",
        "compras",
        "suministros",
        "alquiler",
        "publicidad_marketing",
        "servicios_profesionales",
        "software",
        "transporte",
        "dietas",
        "gastos_financieros",
        "seguros",
        "otros"
      ]
    },
    "base_imponible": {
      "type": "number"
    },
    "tipo_iva": {
      "type": "number",
      "default": 21
    },
    "cuota_iva": {
      "type": "number"
    },
    "retencion_irpf": {
      "type": "number",
      "default": 0
    },
    "importe_retencion": {
      "type": "number",
      "default": 0
    },
    "fiscal_treatment": {
      "type": "string"
    },
    "deductible_tax_amount": {
      "type": "number"
    },
    "non_deductible_tax_amount": {
      "type": "number"
    },
    "total_factura": {
      "type": "number"
    },
    "moneda": {
      "type": "string",
      "default": "EUR"
    },
    "trimestre": {
      "type": "string",
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4"
      ]
    },
    "anio": {
      "type": "number"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "emitida",
        "recibida"
      ],
      "default": "emitida"
    },
    "estado_cobro": {
      "type": "string",
      "enum": [
        "pendiente",
        "parcial",
        "cobrada",
        "vencida"
      ],
      "default": "pendiente"
    },
    "importe_pagado": {
      "type": "number",
      "default": 0
    },
    "importe_pendiente": {
      "type": "number"
    },
    "ultimo_pago_at": {
      "type": "string",
      "format": "date-time"
    },
    "estado_contable": {
      "type": "string",
      "enum": [
        "pendiente",
        "asiento_propuesto",
        "contabilizada",
        "rechazada",
        "requiere_correccion",
        "en_revision",
        "revisada"
      ],
      "default": "pendiente"
    },
    "anulada": {
      "type": "boolean",
      "default": false
    },
    "fecha_anulacion": {
      "type": "string",
      "format": "date-time"
    },
    "motivo_anulacion": {
      "type": "string"
    },
    "linked_journal_entry_id": {
      "type": "string"
    },
    "archivo_url": {
      "type": "string"
    },
    "comentarios": {
      "type": "string"
    },
    "subido_por": {
      "type": "string"
    },
    "confirmado_por": {
      "type": "string"
    },
    "fecha_contabilizacion": {
      "type": "string",
      "format": "date-time"
    },
    "forma_pago": {
      "type": "string"
    },
    "coletilla_fiscal": {
      "type": "string"
    },
    "isRecurringGenerated": {
      "type": "boolean",
      "default": false
    },
    "recurringInvoiceTemplateId": {
      "type": "string"
    },
    "recurringInvoiceRunId": {
      "type": "string"
    },
    "recurringPeriodStart": {
      "type": "string",
      "format": "date"
    },
    "recurringPeriodEnd": {
      "type": "string",
      "format": "date"
    },
    "recurringPeriodKey": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "default": "manual"
    },
    "source_document_type": {
      "type": "string",
      "enum": [
        "presupuesto",
        "proforma"
      ]
    },
    "source_document_id": {
      "type": "string"
    },
    "es_rectificativa": {
      "type": "boolean",
      "default": false
    },
    "factura_rectificada": {
      "type": "string"
    },
    "public_token": {
      "type": "string"
    },
    "public_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_token_revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "estado_envio": {
      "type": "string",
      "enum": [
        "no_enviada",
        "enviada",
        "error_envio"
      ],
      "default": "no_enviada"
    },
    "ocr_document_id": {
      "type": "string"
    },
    "counterparty_account_id": {
      "type": "string"
    },
    "counterparty_account_code": {
      "type": "string"
    },
    "revenue_expense_account_id": {
      "type": "string"
    },
    "revenue_expense_account_code": {
      "type": "string"
    },
    "indirect_tax_kind": {
      "type": "string",
      "enum": [
        "iva",
        "igic",
        "no_aplica",
        "mixto"
      ]
    },
    "accounting_schema_version": {
      "type": "string"
    },
    "accounting_review_status": {
      "type": "string",
      "enum": [
        "pendiente_revision",
        "validada_contabilizada",
        "requiere_correccion",
        "asiento_anulado"
      ],
      "default": "pendiente_revision"
    }
  },
  "required": [
    "company_id",
    "numero_factura",
    "fecha_emision",
    "base_imponible",
    "total_factura"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "read": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "update": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "delete": {
      "data.company_id": "{{user.data.company_id}}"
    }
  }
}