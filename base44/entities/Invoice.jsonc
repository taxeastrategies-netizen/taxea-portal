{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "source_confirmation_lock_token": {
      "type": "string"
    },
    "source_confirmation_lock_recovery": {
      "type": "object"
    },
    "source_last_error": {
      "type": "string"
    },
    "source_confirmation_lock_started_at": {
      "type": "string"
    },
    "fiscal_review_lock_recovery": {
      "type": "object"
    },
    "fiscal_advisor_decision": {
      "type": "object",
      "description": "Criterio confirmado por asesor, separado de la disponibilidad del circuito contable."
    },
    "recc_application_lock_token": {
      "type": "string",
      "rls": {
        "read": false,
        "write": false
      }
    },
    "recc_application_lock_started_at": {
      "type": "string",
      "rls": {
        "read": false,
        "write": false
      }
    },
    "recc_application_lock_document_id": {
      "type": "string",
      "rls": {
        "read": false,
        "write": false
      }
    },
    "recc_metadata": {
      "type": "string",
      "description": "Datos RECC confirmados por asesor: anticipo, concurso y vínculo de rectificación. JSON versionado."
    },
    "tax_breakdown": {
      "type": "string",
      "description": "Desglose de bases y cuotas propuesto en el documento; exige confirmación fiscal."
    },
    "company_id": {
      "type": "string"
    },
    "numero_factura": {
      "type": "string"
    },
    "fecha_emision": {
      "type": "string",
      "format": "date"
    },
    "fecha_vencimiento": {
      "type": "string",
      "format": "date"
    },
    "fecha_operacion": {
      "type": "string",
      "format": "date"
    },
    "fecha_recepcion": {
      "type": "string",
      "format": "date",
      "description": "Fecha real de recepción de la factura recibida. Determina desde qué período puede ejercerse la deducción del IVA/IGIC, sin alterar el devengo contable."
    },
    "cliente_nombre": {
      "type": "string"
    },
    "cliente_nif": {
      "type": "string"
    },
    "cliente_email": {
      "type": "string"
    },
    "cliente_telefono": {
      "type": "string"
    },
    "cliente_direccion": {
      "type": "string"
    },
    "cliente_codigo_postal": {
      "type": "string"
    },
    "cliente_ciudad": {
      "type": "string"
    },
    "cliente_provincia": {
      "type": "string"
    },
    "cliente_pais": {
      "type": "string"
    },
    "proveedor_nombre": {
      "type": "string"
    },
    "proveedor_nif": {
      "type": "string"
    },
    "proveedor_email": {
      "type": "string"
    },
    "proveedor_telefono": {
      "type": "string"
    },
    "proveedor_direccion": {
      "type": "string"
    },
    "proveedor_codigo_postal": {
      "type": "string"
    },
    "proveedor_ciudad": {
      "type": "string"
    },
    "proveedor_provincia": {
      "type": "string"
    },
    "proveedor_pais": {
      "type": "string"
    },
    "concepto": {
      "type": "string"
    },
    "categoria_gasto": {
      "type": "string",
      "enum": [
        "ventas_servicios",
        "compras",
        "suministros",
        "alquiler",
        "publicidad_marketing",
        "servicios_profesionales",
        "software",
        "transporte",
        "dietas",
        "gastos_financieros",
        "seguros",
        "otros"
      ]
    },
    "base_imponible": {
      "type": "number"
    },
    "tipo_iva": {
      "type": "number",
      "default": 21
    },
    "cuota_iva": {
      "type": "number"
    },
    "tipo_recargo": {
      "type": "number",
      "description": "Tipo del recargo de equivalencia consignado separadamente por el proveedor; pendiente de revisión fiscal."
    },
    "cuota_recargo": {
      "type": "number",
      "description": "Cuota de recargo de equivalencia; forma parte del total y del mayor coste de la compra del minorista."
    },
    "retencion_irpf": {
      "type": "number",
      "default": 0
    },
    "importe_retencion": {
      "type": "number",
      "default": 0
    },
    "fiscal_treatment": {
      "type": "string"
    },
    "fiscal_regime": {
      "type": "string",
      "description": "Régimen fiscal aplicado a esta factura; no modifica las subcuentas históricas de terceros."
    },
    "fiscal_activity_id": {
      "type": "string"
    },
    "fiscal_rule_set_version": {
      "type": "string"
    },
    "fiscal_review_status": {
      "type": "string",
      "enum": [
        "pendiente_revision",
        "validado",
        "bloqueado"
      ],
      "default": "pendiente_revision"
    },
    "fiscal_reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "fiscal_reviewed_by": {
      "type": "string"
    },
    "fiscal_manual_override": {
      "type": "boolean",
      "default": false
    },
    "fiscal_manual_override_reason": {
      "type": "string"
    },
    "fiscal_exemption_key": {
      "type": "string"
    },
    "fiscal_legal_basis": {
      "type": "string"
    },
    "deductible_tax_amount": {
      "type": "number"
    },
    "non_deductible_tax_amount": {
      "type": "number"
    },
    "total_factura": {
      "type": "number"
    },
    "moneda": {
      "type": "string",
      "default": "EUR"
    },
    "exchange_rate": {
      "type": "number"
    },
    "trimestre": {
      "type": "string",
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4"
      ]
    },
    "anio": {
      "type": "number"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "emitida",
        "recibida"
      ],
      "default": "emitida"
    },
    "estado_cobro": {
      "type": "string",
      "enum": [
        "pendiente",
        "parcial",
        "cobrada",
        "vencida"
      ],
      "default": "pendiente"
    },
    "importe_pagado": {
      "type": "number",
      "default": 0
    },
    "importe_pendiente": {
      "type": "number"
    },
    "ultimo_pago_at": {
      "type": "string",
      "format": "date-time"
    },
    "estado_contable": {
      "type": "string",
      "enum": [
        "pendiente",
        "asiento_propuesto",
        "contabilizada",
        "rechazada",
        "requiere_correccion",
        "en_revision",
        "revisada"
      ],
      "default": "pendiente"
    },
    "anulada": {
      "type": "boolean",
      "default": false
    },
    "fecha_anulacion": {
      "type": "string",
      "format": "date-time"
    },
    "motivo_anulacion": {
      "type": "string"
    },
    "linked_journal_entry_id": {
      "type": "string"
    },
    "archivo_url": {
      "type": "string"
    },
    "comentarios": {
      "type": "string"
    },
    "subido_por": {
      "type": "string"
    },
    "confirmado_por": {
      "type": "string"
    },
    "fecha_contabilizacion": {
      "type": "string",
      "format": "date-time"
    },
    "forma_pago": {
      "type": "string"
    },
    "coletilla_fiscal": {
      "type": "string"
    },
    "isRecurringGenerated": {
      "type": "boolean",
      "default": false
    },
    "recurringInvoiceTemplateId": {
      "type": "string"
    },
    "recurringInvoiceRunId": {
      "type": "string"
    },
    "recurringPeriodStart": {
      "type": "string",
      "format": "date"
    },
    "recurringPeriodEnd": {
      "type": "string",
      "format": "date"
    },
    "recurringPeriodKey": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "default": "manual"
    },
    "creation_idempotency_key": {
      "type": "string",
      "description": "Clave estable de creación para impedir facturas duplicadas por reintentos de red o doble clic."
    },
    "canonical_document_key": {
      "type": "string",
      "description": "Huella normalizada por empresa, tipo, número, fecha e importe usada por el núcleo financiero."
    },
    "source_system": {
      "type": "string",
      "default": "taxea_portal"
    },
    "source_record_id": {
      "type": "string"
    },
    "source_hash": {
      "type": "string"
    },
    "qr_url": {
      "type": "string",
      "description": "URL tributaria AEAT fijada al emitir la factura; no acredita remisión VERI*FACTU."
    },
    "qr_integrity_hash": {
      "type": "string",
      "description": "SHA-256 interno de empresa, identificador persistido y QR exacto. No es huella fiscal VERI*FACTU ni firma del PDF."
    },
    "qr_integrity_version": {
      "type": "string",
      "description": "Versión del algoritmo interno para verificar la huella conservada."
    },
    "qr_integrity_algorithm": {
      "type": "string"
    },
    "qr_integrity_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha real de asignación; en históricos no se retrofecha a la emisión."
    },
    "qr_mode": {
      "type": "string",
      "enum": [
        "no_verifactu",
        "verifactu"
      ],
      "description": "Sólo usar verifactu tras envío y aceptación efectiva del registro."
    },
    "qr_spec_version": {
      "type": "string"
    },
    "qr_pdf_url": {
      "type": "string",
      "description": "PDF derivado con QR tributario; conserva el archivo original en archivo_url."
    },
    "lifecycle_version": {
      "type": "integer",
      "default": 1
    },
    "source_document_type": {
      "type": "string",
      "enum": [
        "presupuesto",
        "proforma"
      ]
    },
    "source_document_id": {
      "type": "string"
    },
    "es_rectificativa": {
      "type": "boolean",
      "default": false
    },
    "factura_rectificada": {
      "type": "string"
    },
    "public_token": {
      "type": "string"
    },
    "public_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_token_revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "estado_envio": {
      "type": "string",
      "enum": [
        "no_enviada",
        "enviada",
        "error_envio"
      ],
      "default": "no_enviada"
    },
    "ocr_document_id": {
      "type": "string"
    },
    "counterparty_account_id": {
      "type": "string"
    },
    "counterparty_account_code": {
      "type": "string"
    },
    "revenue_expense_account_id": {
      "type": "string"
    },
    "revenue_expense_account_code": {
      "type": "string"
    },
    "indirect_tax_kind": {
      "type": "string",
      "enum": [
        "iva",
        "igic",
        "no_aplica",
        "mixto"
      ]
    },
    "accounting_schema_version": {
      "type": "string"
    },
    "accounting_migration_hold": {
      "type": "boolean",
      "default": false
    },
    "accounting_migration_hold_reason": {
      "type": "string"
    },
    "accounting_review_status": {
      "type": "string",
      "enum": [
        "pendiente_revision",
        "validada_contabilizada",
        "requiere_correccion",
        "asiento_anulado",
        "unidad_en_preparacion"
      ],
      "default": "pendiente_revision"
    },
    "self_assessed_tax_amount": {
      "type": "number",
      "description": "Cuota autorrepercutida confirmada. No forma parte de la deuda con el proveedor."
    },
    "self_assessed_tax_rate": {
      "type": "number"
    },
    "self_assessed_tax_confirmed": {
      "type": "boolean",
      "default": false
    },
    "fiscal_review_lock_token": {
      "type": "string"
    },
    "fiscal_review_lock_started_at": {
      "type": "string"
    },
    "fiscal_review_batch_id": {
      "type": "string"
    },
    "payment_lock_token": {
      "type": "string"
    },
    "payment_lock_started_at": {
      "type": "string"
    },
    "payment_lock_key": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "numero_factura",
    "fecha_emision",
    "base_imponible",
    "total_factura"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
