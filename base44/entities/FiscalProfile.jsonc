{
  "name": "FiscalProfile",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "fiscalName": {
      "type": "string"
    },
    "taxId": {
      "type": "string"
    },
    "entityType": {
      "type": "string",
      "enum": [
        "autonomo",
        "sociedad",
        "comunidad_bienes",
        "sociedad_civil",
        "asociacion_fundacion",
        "entidad_publica",
        "otra"
      ],
      "default": "autonomo"
    },
    "mainTerritory": {
      "type": "string",
      "enum": [
        "peninsula_baleares",
        "canarias",
        "ceuta_melilla",
        "ue",
        "no_ue"
      ],
      "default": "peninsula_baleares"
    },
    "taxAuthority": {
      "type": "string",
      "enum": [
        "aeat",
        "atc",
        "ambas",
        "otra"
      ],
      "default": "aeat"
    },
    "filingFrequency": {
      "type": "string",
      "enum": [
        "trimestral",
        "mensual",
        "anual",
        "ocasional"
      ],
      "default": "trimestral"
    },
    "fiscalYear": {
      "type": "number"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "isLargeCompany": {
      "type": "boolean",
      "default": false
    },
    "isREDEME": {
      "type": "boolean",
      "default": false
    },
    "usesSII": {
      "type": "boolean",
      "default": false
    },
    "usesVeriFactu": {
      "type": "boolean",
      "default": false
    },
    "indirectTaxDefault": {
      "type": "string",
      "enum": [
        "iva",
        "igic",
        "no_aplica",
        "mixto"
      ],
      "default": "iva"
    },
    "defaultVatRate": {
      "type": "number",
      "default": 21
    },
    "defaultIgicRate": {
      "type": "number",
      "default": 7
    },
    "subjectToIRPF": {
      "type": "boolean",
      "default": false
    },
    "irpfEstimation": {
      "type": "string",
      "enum": [
        "directa_normal",
        "directa_simplificada",
        "objetiva_modulos",
        "no_aplica"
      ],
      "default": "no_aplica"
    },
    "defaultWithholdingRate": {
      "type": "number",
      "default": 0
    },
    "professionalActivityStartDate": {
      "type": "string",
      "format": "date"
    },
    "isProfessionalWithRetention": {
      "type": "boolean",
      "default": false
    },
    "isPropertyLessor": {
      "type": "boolean",
      "default": false
    },
    "retainedIncomePercent": {
      "type": "number",
      "default": 0
    },
    "model130ExemptionConfirmed": {
      "type": "boolean",
      "default": false
    },
    "repepStatus": {
      "type": "string",
      "enum": [
        "no_aplica",
        "incluido",
        "renunciado",
        "excluido",
        "transitorio_2026"
      ],
      "default": "no_aplica"
    },
    "repepEffectiveFrom": {
      "type": "string",
      "format": "date"
    },
    "repepEffectiveUntil": {
      "type": "string",
      "format": "date"
    },
    "paysEmploymentOrProfessionalIncome": {
      "type": "boolean",
      "default": false
    },
    "paysUrbanRent": {
      "type": "boolean",
      "default": false
    },
    "paysCapitalIncome": {
      "type": "boolean",
      "default": false
    },
    "hasNonResidentOperations": {
      "type": "boolean",
      "default": false
    },
    "hasThirdPartyReporting": {
      "type": "boolean",
      "default": false
    },
    "profileStatus": {
      "type": "string",
      "enum": [
        "incompleto",
        "pendiente_revision",
        "validado_asesor"
      ],
      "default": "pendiente_revision"
    },
    "censusValidationSource": {
      "type": "string",
      "enum": [
        "pendiente_confirmar",
        "modelo_036",
        "modelo_400",
        "certificado_censal",
        "criterio_asesor"
      ],
      "default": "pendiente_confirmar"
    },
    "ruleSetVersion": {
      "type": "string"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewedBy": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_id",
    "fiscalName",
    "mainTerritory"
  ],
  "rls": {
    "create": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "delete": {
      "data.company_id": "{{user.data.company_id}}"
    }
  }
}