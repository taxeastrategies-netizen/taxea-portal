{
  "name": "Expense",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "ingreso",
        "gasto"
      ],
      "default": "gasto"
    },
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "proveedor_cliente": {
      "type": "string"
    },
    "concepto": {
      "type": "string"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "ventas_servicios",
        "compras",
        "suministros",
        "alquiler",
        "publicidad_marketing",
        "servicios_profesionales",
        "software",
        "transporte",
        "dietas",
        "gastos_financieros",
        "seguros",
        "otros"
      ]
    },
    "base_imponible": {
      "type": "number"
    },
    "tipo_impuesto": {
      "type": "number"
    },
    "cuota_impuesto": {
      "type": "number"
    },
    "retencion_irpf": {
      "type": "number",
      "default": 0
    },
    "retencion_tipo": {
      "type": "string"
    },
    "total": {
      "type": "number"
    },
    "importe_retencion": {
      "type": "number",
      "default": 0
    },
    "treasury_account_code": {
      "type": "string",
      "description": "Subcuenta de caja o banco usada en el asiento del registro manual."
    },
    "trimestre": {
      "type": "string",
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4"
      ]
    },
    "anio": {
      "type": "number"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "en_revision",
        "revisado",
        "contabilizado",
        "rechazado"
      ],
      "default": "pendiente"
    },
    "archivo_url": {
      "type": "string"
    },
    "subido_por": {
      "type": "string"
    },
    "anulada": {
      "type": "boolean",
      "default": false
    },
    "fecha_anulacion": {
      "type": "string",
      "format": "date-time"
    },
    "motivo_anulacion": {
      "type": "string"
    },
    "anulada_por": {
      "type": "string"
    },
    "document_number": {
      "type": "string"
    },
    "tax_id": {
      "type": "string"
    },
    "record_kind": {
      "type": "string",
      "enum": [
        "manual_non_invoice",
        "legacy",
        "ticket",
        "other_support"
      ],
      "default": "manual_non_invoice"
    },
    "canonical_event_key": {
      "type": "string",
      "description": "Clave idempotente del registro manual en el n\u00facleo financiero."
    },
    "canonical_invoice_id": {
      "type": "string",
      "description": "Factura can\u00f3nica equivalente cuando el registro legacy era una proyecci\u00f3n duplicada."
    },
    "linked_journal_entry_id": {
      "type": "string"
    },
    "accounting_review_status": {
      "type": "string",
      "enum": [
        "pendiente_revision",
        "validado_contabilizado",
        "requiere_correccion",
        "asiento_anulado"
      ],
      "default": "pendiente_revision"
    },
    "source_system": {
      "type": "string",
      "default": "taxea_portal"
    },
    "source_record_id": {
      "type": "string"
    },
    "source_hash": {
      "type": "string"
    },
    "lifecycle_version": {
      "type": "integer",
      "default": 1
    }
  },
  "required": [
    "company_id",
    "fecha",
    "concepto",
    "total"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.company_id": "{{user.data.company_id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}