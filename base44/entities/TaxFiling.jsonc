{
  "name": "TaxFiling",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string"
    },
    "modeloCodigo": {
      "type": "string"
    },
    "taxPeriodId": {
      "type": "string"
    },
    "ejercicio": {
      "type": "number"
    },
    "periodo": {
      "type": "string"
    },
    "estadoPresentacion": {
      "type": "string",
      "enum": [
        "pendiente",
        "en_proceso",
        "presentado",
        "rechazado",
        "con_requerimiento",
        "subsanado"
      ],
      "default": "pendiente"
    },
    "via": {
      "type": "string",
      "enum": [
        "conector_aeat",
        "conector_atc",
        "fichero_exportado",
        "importacion_a3",
        "presentacion_manual"
      ],
      "default": "presentacion_manual"
    },
    "fechaPresentacion": {
      "type": "string",
      "format": "date"
    },
    "fechaImportacion": {
      "type": "string",
      "format": "date-time"
    },
    "importadoPor": {
      "type": "string"
    },
    "snapshotVersion": {
      "type": "integer",
      "default": 1
    },
    "tipoDeclaracion": {
      "type": "string",
      "enum": [
        "original",
        "complementaria",
        "rectificativa",
        "sustitutiva"
      ],
      "default": "original"
    },
    "declaracionAnteriorId": {
      "type": "string"
    },
    "numeroJustificanteAnterior": {
      "type": "string"
    },
    "numeroJustificante": {
      "type": "string"
    },
    "csv": {
      "type": "string"
    },
    "respuestaAdministracion": {
      "type": "string"
    },
    "justificantePdfUrl": {
      "type": "string"
    },
    "ficheroPresentadoUrl": {
      "type": "string"
    },
    "nombreFicheroImportado": {
      "type": "string"
    },
    "hashFicheroImportado": {
      "type": "string"
    },
    "fuenteImportacion": {
      "type": "string",
      "enum": [
        "fichero_oficial",
        "pdf_ocr_revisado",
        "manual_revisado",
        "taxea"
      ]
    },
    "casillasPresentadas": {
      "type": "object",
      "description": "Foto inmutable de las casillas del modelo realmente presentado."
    },
    "sourceIdsPresentados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fuentes Taxea incluidas cuando la presentaci\u00f3n se gener\u00f3 desde la plataforma."
    },
    "snapshotBloqueado": {
      "type": "boolean",
      "default": true
    },
    "revisionImportacion": {
      "type": "string",
      "enum": [
        "pendiente_revision",
        "revisado_usuario",
        "validado_estructura",
        "validado_asesor"
      ],
      "default": "pendiente_revision"
    },
    "avisosImportacion": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confianzaExtraccion": {
      "type": "string",
      "enum": [
        "alta",
        "media",
        "baja"
      ]
    },
    "snapshotHash": {
      "type": "string"
    },
    "analisisArrastre": {
      "type": "object"
    },
    "confirmadoPorUsuario": {
      "type": "boolean",
      "default": false
    },
    "usuarioPresentador": {
      "type": "string"
    },
    "importeFinal": {
      "type": "number",
      "default": 0
    },
    "resultadoDestino": {
      "type": "string",
      "enum": [
        "a_ingresar",
        "a_compensar",
        "a_devolver",
        "a_deducir",
        "negativa",
        "cero",
        "sin_actividad"
      ],
      "description": "Destino confirmado del resultado presentado; necesario para reconstruir saldos a compensar."
    },
    "notas": {
      "type": "string"
    }
  },
  "required": [
    "companyId",
    "modeloCodigo",
    "ejercicio",
    "periodo"
  ],
  "rls": {
    "create": {
      "data.companyId": "{{user.data.company_id}}"
    },
    "read": {
      "data.companyId": "{{user.data.company_id}}"
    },
    "update": {
      "data.companyId": "{{user.data.company_id}}"
    },
    "delete": {
      "data.companyId": "{{user.data.company_id}}"
    }
  }
}