{
  "name": "AccountingConfiguration",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string"
    },
    "mappingsJson": {
      "type": "string"
    },
    "clientAccount": {
      "type": "string",
      "default": "43000000"
    },
    "supplierAccount": {
      "type": "string",
      "default": "41000000"
    },
    "outputTaxAccount": {
      "type": "string",
      "default": "47700000"
    },
    "inputTaxAccount": {
      "type": "string",
      "default": "47200000"
    },
    "withholdingReceivableAccount": {
      "type": "string",
      "default": "47300000"
    },
    "withholdingPayableAccount": {
      "type": "string",
      "default": "47510000"
    },
    "updatedBy": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "accountDigits": {
      "type": "number",
      "default": 8
    },
    "customerSequencePrefix": {
      "type": "string",
      "default": "4300"
    },
    "supplierSequencePrefix": {
      "type": "string",
      "default": "4000"
    },
    "creditorSequencePrefix": {
      "type": "string",
      "default": "4100"
    },
    "accountingSchemaVersion": {
      "type": "string",
      "default": "pgc8-v1"
    },
    "accountingModel": {
      "type": "string",
      "enum": [
        "interno_simplificado",
        "pyme",
        "abreviado",
        "normal"
      ],
      "default": "interno_simplificado"
    },
    "baseCurrency": {
      "type": "string",
      "default": "EUR"
    },
    "unmatchedIncomingAccount": {
      "type": "string",
      "default": "55500000"
    },
    "unmatchedOutgoingMode": {
      "type": "string",
      "enum": [
        "revision",
        "cuenta_configurada"
      ],
      "default": "revision"
    },
    "unmatchedOutgoingAccount": {
      "type": "string"
    },
    "autoSeedAccounts": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "companyId"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.companyId": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}