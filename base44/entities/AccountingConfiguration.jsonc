{
  "name": "AccountingConfiguration",
  "type": "object",
  "properties": {
    "companyId": {
      "type": "string"
    },
    "mappingsJson": {
      "type": "string"
    },
    "clientAccount": {
      "type": "string",
      "default": "43000000"
    },
    "supplierAccount": {
      "type": "string",
      "default": "41000000"
    },
    "outputTaxAccount": {
      "type": "string",
      "default": "47700000"
    },
    "inputTaxAccount": {
      "type": "string",
      "default": "47200000"
    },
    "withholdingReceivableAccount": {
      "type": "string",
      "default": "47300000"
    },
    "withholdingPayableAccount": {
      "type": "string",
      "default": "47510000"
    },
    "updatedBy": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "accountDigits": {
      "type": "number",
      "default": 8
    },
    "customerSequencePrefix": {
      "type": "string",
      "default": "4300"
    },
    "supplierSequencePrefix": {
      "type": "string",
      "default": "4000"
    },
    "creditorSequencePrefix": {
      "type": "string",
      "default": "4100"
    },
    "accountingSchemaVersion": {
      "type": "string",
      "default": "pgc8-v1"
    }
  },
  "required": [
    "companyId"
  ],
  "rls": {
    "create": {
      "data.companyId": "{{user.data.company_id}}"
    },
    "read": {
      "$or": [
        {
          "data.companyId": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "data.companyId": "{{user.data.company_id}}"
    },
    "delete": {
      "data.companyId": "{{user.data.company_id}}"
    }
  }
}