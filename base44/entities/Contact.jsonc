{
  "name": "Contact",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "nombre": {
      "type": "string"
    },
    "razon_social": {
      "type": "string"
    },
    "nif_cif": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "cliente",
        "proveedor",
        "ambos"
      ],
      "default": "cliente"
    },
    "clase_contacto": {
      "type": "string",
      "enum": [
        "empresa",
        "persona"
      ]
    },
    "direccion_fiscal": {
      "type": "string"
    },
    "codigo_postal": {
      "type": "string"
    },
    "ciudad": {
      "type": "string"
    },
    "provincia": {
      "type": "string"
    },
    "pais": {
      "type": "string",
      "default": "Espa\u00f1a"
    },
    "email": {
      "type": "string"
    },
    "telefono": {
      "type": "string"
    },
    "emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "telefonos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "persona_contacto": {
      "type": "string"
    },
    "organismo_publico": {
      "type": "boolean",
      "default": false
    },
    "notas": {
      "type": "string"
    },
    "actividad": {
      "type": "string"
    },
    "regimen_fiscal": {
      "type": "string"
    },
    "origen_automatico": {
      "type": "boolean",
      "default": false
    },
    "fuentes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "factura_origen_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ocr_origen_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ultima_factura_id": {
      "type": "string"
    },
    "ultimo_documento_ocr_id": {
      "type": "string"
    },
    "primera_deteccion_at": {
      "type": "string",
      "format": "date-time"
    },
    "ultima_deteccion_at": {
      "type": "string",
      "format": "date-time"
    },
    "capturado_por_user_id": {
      "type": "string"
    },
    "capturado_por_email": {
      "type": "string"
    },
    "consentimiento_comercial": {
      "type": "string",
      "enum": [
        "no_solicitado",
        "concedido",
        "revocado",
        "no_aplica"
      ],
      "default": "no_solicitado"
    },
    "uso_contacto": {
      "type": "string",
      "default": "operativo_facturacion"
    },
    "merged_into_contact_id": {
      "type": "string"
    },
    "activo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "company_id",
    "nombre"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}